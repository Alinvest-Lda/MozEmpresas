# Preferred, provider-neutral PostgreSQL connection for server-side operations.
# Use the connection string supplied by your PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Keep TLS enabled by default. Set to "disable" only for local development.
DATABASE_SSL=require

# Header inserted by the trusted hosting proxy to identify the client IP.
# Default is appropriate for Vercel; configure for another provider.
TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for

# Legacy Supabase variables still required by authentication and features not yet migrated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Institutional report email delivery (Resend).
# Use a sender address on a domain verified in Resend.
# These variables are optional for local builds; sending stays disabled until configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# M-Pesa Open API (server-side only).
# Keep MPESA_API_KEY as a Secret in Vercel. Never use NEXT_PUBLIC_ for credentials.
# Sandbox only: checkout refuses any environment/host other than the Vodacom Sandbox.
MPESA_ENVIRONMENT=sandbox
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_API_BASE_URL=https://api.sandbox.vm.co.mz
# Legacy internal merchant identifier consumed by the current callback implementation.
# It is not the field used to route Open API requests; keep it distinct from the Service Provider Code.
MPESA_MERCHANT_CODE=
# Use the merchant Organization Shortcode when it is the Service Provider Code for this API account.
# Confirm the mapping in the authenticated Vodacom portal; do not invent a second shortcode.
MPESA_SERVICE_PROVIDER_CODE=
# Sandbox Open API routing parameters confirmed in the supplied examples.
MPESA_ORIGIN=developer.mpesa.vm.co.mz
MPESA_C2B_PORT=18352
MPESA_STATUS_PORT=18353
# No MPESA_WEBHOOK_SECRET: Vodacom has not specified a shared webhook secret for this account.
# Operation ports and callback URL requirements must be copied from the authenticated developer-portal docs.
