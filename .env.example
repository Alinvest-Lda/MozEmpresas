# Preferred, provider-neutral PostgreSQL connection for server-side operations.
# Use the connection string supplied by your PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Keep TLS enabled by default. Set to "disable" only for local development.
DATABASE_SSL=require

# Header inserted by the trusted hosting proxy to identify the client IP.
# Default is appropriate for Vercel; configure for another provider.
TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for

# Legacy Supabase variables still required by authentication and features not yet migrated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
